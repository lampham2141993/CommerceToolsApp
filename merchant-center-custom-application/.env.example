# Merchant Center Custom Application local development
ENABLE_NEW_JSX_TRANSFORM="true"
FAST_REFRESH="true"

# Connect / Custom Application (required for local start & Connect deploy)
ENTRY_POINT_URI_PATH=starter-typescript-4e8eec
CLOUD_IDENTIFIER=gcp-au
# CUSTOM_APPLICATION_ID=   # set after registering in Merchant Center
# APPLICATION_URL=         # set by Connect at deploy time (do not set manually for Connect)

# commercetools API client credentials (Merchant Center → Settings → Developer settings)
# Used by scripts/health-check.ts — not required for mc-scripts start
CTP_PROJECT_KEY=your-project-key
CTP_CLIENT_ID=your-client-id
CTP_CLIENT_SECRET=your-client-secret

# Region shorthand (used to derive auth/api URLs when not set explicitly)
CTP_REGION=australia-southeast1.gcp

# Optional explicit hosts (override CTP_REGION)
# CTP_AUTH_URL=https://auth.australia-southeast1.gcp.commercetools.com
# CTP_API_URL=https://api.australia-southeast1.gcp.commercetools.com

# Space-separated OAuth scopes assigned to the API client
CTP_SCOPES="manage_products:your-project-key manage_categories:your-project-key manage_project:your-project-key view_key_value_documents:your-project-key manage_key_value_documents:your-project-key"
